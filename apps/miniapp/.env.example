# URL of the SnapBite Worker API for local dev and self-hosting. (On
# https://snapbite.leeguanfeng.com the app ignores this and calls /api/* on its
# own origin, where the Worker is routed.)
# URL of the SnapBite Worker API. Leave empty to run on the mock processor
# (browser dev, no backend). Example for local wrangler dev:
#   VITE_WORKER_URL=http://localhost:8787
VITE_WORKER_URL=
