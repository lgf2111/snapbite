# Cloudflare Pages headers.
# https://developers.cloudflare.com/pages/configuration/headers/

# Never cache the HTML entry: it points at hashed asset files, so a stale copy
# would keep loading an old bundle (this caused the Telegram webview + browsers
# to show an outdated UI after deploys). Always revalidate.
/
  Cache-Control: no-cache, must-revalidate
/index.html
  Cache-Control: no-cache, must-revalidate

# Hashed build assets are content-addressed (filename changes on every build),
# so they're safe to cache aggressively and immutably.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker file must always be revalidated, or a stale copy can keep
# running for a day. It is also what the browser byte-compares to detect updates.
/sw.js
  Cache-Control: no-cache, must-revalidate

/shortcut/*
  Content-Type: application/octet-stream
