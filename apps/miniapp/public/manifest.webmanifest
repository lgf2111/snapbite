{
  "name": "SnapBite",
  "short_name": "SnapBite",
  "description": "Snap a photo of your meal, get calories and macros. Every number is editable.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#080d16",
  "theme_color": "#080d16",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon.png",
      "sizes": "1254x1254",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Take a photo",
      "short_name": "Take a photo",
      "description": "Open SnapBite ready to take a meal photo",
      "url": "/?capture=camera",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Upload a photo",
      "short_name": "Upload photo",
      "description": "Open SnapBite ready to pick a photo from your gallery",
      "url": "/?capture=library",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Log by hand",
      "short_name": "Log by hand",
      "description": "Open SnapBite on the by-hand form",
      "url": "/?capture=manual",
      "icons": [
        {
          "src": "/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "text": "text",
      "files": [
        {
          "name": "photo",
          "accept": ["image/*"]
        }
      ]
    }
  }
}
