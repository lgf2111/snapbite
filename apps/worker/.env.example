# SnapBite Worker — configuration for running your own instance.
#
# Cloudflare Workers: bindings live in wrangler.toml, everything below is a
# SECRET. Locally use a `.dev.vars` file (copy this, fill it, never commit it);
# in production set them with `wrangler secret put <NAME>`.
#
#   cp apps/worker/.env.example apps/worker/.dev.vars   # then edit
#   npx wrangler secret put TELEGRAM_BOT_TOKEN   # from apps/worker
#
# Never commit real values. `.dev.vars` and `.env` are gitignored.

# --- required ---------------------------------------------------------------

# Token from @BotFather for YOUR bot. Used to verify Mini App initData and to
# send messages. Format: 123456789:AA...
TELEGRAM_BOT_TOKEN=

# AES-256-GCM master key for the stored (BYOK) provider keys: 32 random bytes,
# base64. Generate one and keep it stable — rotating it makes every stored user
# key undecryptable:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- recommended ------------------------------------------------------------

# HTTPS URL of the deployed Mini App (Cloudflare Pages), e.g.
# https://snapbite.example.com — used for the web_app button in bot messages.
MINI_APP_URL=

# Shared secret Telegram echoes in X-Telegram-Bot-Api-Secret-Token. Set it when
# you register the webhook (setWebhook secret_token=...), otherwise anyone who
# finds the URL can post fake updates.
TELEGRAM_WEBHOOK_SECRET=

# Your own numeric Telegram user id — gates the admin commands (/stats, /errors,
# and the feedback review) and is where error alerts are DMed when no admin
# group is configured. Unset = admin commands and alerts are simply off.
# Get it from @userinfobot.
ADMIN_TELEGRAM_ID=

# --- optional: send admin alerts into a supergroup's forum topics -------------

# Negative supergroup id, e.g. -1003990101342. When set, alerts post to Topics
# in that group instead of DMing ADMIN_TELEGRAM_ID. Add the bot to the group
# first, with permission to post.
ADMIN_GROUP_CHAT_ID=
ERRORS_THREAD_ID=
FEEDBACK_THREAD_ID=
BROADCAST_THREAD_ID=
