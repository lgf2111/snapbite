{
  "name": "@snapbite/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SnapBite Cloudflare Worker: Hono API, D1 (Drizzle), Telegram initData auth.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply snapbite-db --local",
    "bot:commands": "node scripts/set-bot-commands.mjs",
    "bot:profile": "node scripts/set-bot-profile.mjs"
  },
  "dependencies": {
    "@snapbite/core": "workspace:*",
    "drizzle-orm": "^0.38.2",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.40",
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.10.2",
    "drizzle-kit": "^0.30.1",
    "typescript": "^5.6.3",
    "vitest": "2.1.8",
    "wrangler": "^3.99.0"
  }
}
